# =============================================================================
# upload_to_meta_bot — environment template
# Copy: cp .env.example .env   then fill secrets. Never commit .env.
# =============================================================================
#
# DEPENDENCY MAP (high level)
# ---------------------------
# Core bot (always):     API_ID, API_HASH, BOT_TOKEN, OWNER_ID, DB_PATH
# Meta Graph (always):  META_ACCESS_TOKEN  (fallback when publish payload has no page_access_token)
# IG photo via Storage: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SUPABASE_STORAGE_BUCKET (all three)
# Firestore worker:     FIRESTORE_POLLING_ENABLED=true + FIRESTORE_PROJECT_ID + GCP credentials
#                       (see Google “Application Default Credentials”; often GOOGLE_APPLICATION_CREDENTIALS)
#
# NOT in Config.py (tests only):
#   META_RUN_LIVE_TESTS=1  —  pytest integration; needs META_ACCESS_TOKEN
#
# Google Drive paths are fixed in code (google_drive/credentials/*.json). README may mention
# GDRIVE_* overrides — those are not read by Config.py today.
#
# =============================================================================
# TELEGRAM (required)
# =============================================================================
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# SQLite path (required), e.g. data/database.sqlite3
DB_PATH=data/database.sqlite3

# Optional: numeric chat_id for error reports
# ERRORS_CHANNEL=

# Optional: numeric chat_id for publish success/failure summaries
# PUBLISH_RESULTS_CHANNEL=

# =============================================================================
# LOGGING
# =============================================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# =============================================================================
# META / FACEBOOK / INSTAGRAM (Graph API)
# =============================================================================
# Long-lived user token with page permissions; used when payload has no page_access_token
META_ACCESS_TOKEN=

# Graph version (default v25.0)
META_GRAPH_VERSION=v25.0

# Instagram/Facebook resumable upload host (change only if Meta documents a new base)
RUUPLOAD_BASE=https://rupload.facebook.com

# Seconds; minimum enforced in code is 60
META_HTTP_TIMEOUT_TOTAL=600

# =============================================================================
# TELEGRAM MEDIA SIZE (also applies to HTTP media_url downloads in publish jobs)
# =============================================================================
# Max megabytes loaded into memory for one publish download (Telethon, Bot API, or media_url GET)
TELEGRAM_MEDIA_MAX_MB=200

# =============================================================================
# INSTAGRAM VIDEO — ffmpeg / ffprobe (install BOTH on the server)
# =============================================================================
# Binary name or full path. ffprobe is resolved next to this name (ffmpeg.exe → ffprobe.exe)
FFMPEG_BIN=ffmpeg

# Master switch: if false, required ffmpeg fixes raise instead of running
IG_VIDEO_AUTOFIX_ENABLED=true

# After a failed “remux only” (-c copy + faststart), allow full re-encode
IG_VIDEO_AUTOFIX_REENCODE_FALLBACK=true

# If true: run ffprobe and re-encode when video is not H.264 / not AAC / bad pixel format, etc.
# If false: no codec probe — good MP4 layout may still pass through as HEVC and FAIL on Meta.
# Soft pair: keep true unless you know all sources are already IG-safe H.264+AAC.
IG_VIDEO_REENCODE_IF_INCOMPATIBLE=true

# If true: ALWAYS re-encode every IG video to H.264/AAC + faststart (slowest, safest).
# Practically overrides “skip when already compatible” — use when Meta still rejects files.
# Not mutually exclusive with others; it dominates the pipeline when true.
IG_VIDEO_FORCE_REENCODE=false

# If true: when ffprobe runs but cannot classify the file (returns inconclusive), FAIL EARLY
# with meta_err_ig_video_probe_ambiguous instead of uploading to Meta.
# Only applies in that edge case; unrelated to IG_VIDEO_FORCE_REENCODE.
IG_VIDEO_STRICT_PROBE=false

# Re-encode quality when transcoding is required (H.264/AAC/yuv420p/faststart output unchanged).
# Lower CRF = higher quality (18 ≈ near-visually-lossless; ffmpeg default without -crf is ~23).
IG_VIDEO_CRF=18
IG_VIDEO_ENCODE_PRESET=medium
IG_VIDEO_AUDIO_BITRATE=192k

# Seconds per ffmpeg invocation (default 600). On timeout/failure, one retry uses veryfast + CRF+4.
IG_VIDEO_FFMPEG_TIMEOUT=600

# Oversized frames (longer side > 1920 or shorter side > 1080) are downscaled on re-encode only
# to fit 1080x1920 (portrait) or 1920x1080 (landscape). Smaller sources are left at native size.
# CRF is unchanged — this is for IG encode time on a small VPS, not a quality preset change.

# Last-resort frame rate, used only when the source rate cannot be preserved.
# Frame rate is never reduced when it does not have to be:
#   constant and 23-60 fps  → kept verbatim (including 30000/1001)
#   variable, avg in range  → pinned to its own measured average (60 fps phone
#                             clips stay 60; they are almost always VFR)
#   variable, avg > 60      → clamped to 60
#   nothing measurable      → this value
IG_REELS_TARGET_FPS=30

# After Meta rejects an upload with ProcessingFailedError, retry ONCE with a smaller,
# more conservative encode against a fresh container. Meta marks these retriable:false,
# which is true of that byte-stream — a different encode is a different payload.
# This retry DOES trade quality for acceptance, but only on a post that already failed:
# the choice is a softer reel or no reel. Set RETRY=false to fail instead, or raise
# SAFE_MODE_LONG_SIDE to 1920 to keep resolution and vary only the encode.
IG_REELS_SAFE_MODE_RETRY=true
IG_REELS_SAFE_MODE_CRF=23
IG_REELS_SAFE_MODE_LONG_SIDE=1280

# ---------------------------------------------------------------------------
# Reels spec enforced before upload (ffprobe required)
# ---------------------------------------------------------------------------
# Repaired automatically by re-encoding / remuxing:
#   variable frame rate, fps outside 23-60, odd dimensions, audio not 48 kHz,
#   more than 2 audio channels, extra tracks (cover art / timecode / data),
#   non-MP4 container, non-H.264 video, 10-bit or non-yuv420p pixel formats,
#   non-AAC audio, frames over 1080x1920, mdat before moov.
# Rejected up front (no re-encode can repair them):
#   duration < 3s (meta_err_ig_video_too_short), duration > 15min
#   (meta_err_ig_video_too_long), aspect ratio outside 0.01:1-10:1
#   (meta_err_ig_video_aspect_ratio).
# Diagnose any file without publishing:  python -m scripts.ig_video_check <path-or-url>

# ---------------------------------------------------------------------------
# IG_VIDEO_* interactions (quick reference)
# ---------------------------------------------------------------------------
# IG_VIDEO_AUTOFIX_ENABLED=false  →  no ffmpeg repair path (fails if fix needed).
# IG_VIDEO_FORCE_REENCODE=true    →  always re-encode (heaviest). With ffprobe installed
#       this is no longer needed: the spec check above already catches every property
#       Meta rejects, and re-encodes only files that actually violate one.
# IG_VIDEO_REENCODE_IF_INCOMPATIBLE=false + IG_VIDEO_FORCE_REENCODE=false
#       →  no codec-based re-encode unless moov/mdat layout triggers remux (risky for HEVC).
# ffprobe MUST be on PATH (or next to FFMPEG_BIN). Without it every codec, dimension and
#       Reels-spec check silently no-ops and files reach Meta unverified — the most common
#       cause of meta_err_ig_resumable_upload / ProcessingFailedError. The bot logs
#       ffprobe_available=... on startup; check that line first when reels start failing.
# IG_VIDEO_FFMPEG_TIMEOUT too low on a small VPS → meta_err_ig_video_prepare_failed (ffmpeg_timeout_*).

# =============================================================================
# SUPABASE STORAGE (optional — Instagram *photo* when you upload via Telegram file_id
#                     without a public image URL; not used for R2 mediaUrl-only flows)
# =============================================================================
# All three required together for that code path; omit all if you only use public media URLs.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# Present in Config but unused by current publish code paths (reserved / future)
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_DB_PASSWORD=

# =============================================================================
# FIRESTORE POLLER (optional — scheduled posts from Point / external app)
# =============================================================================
FIRESTORE_POLLING_ENABLED=false
# Required when polling enabled (empty uses Application Default project)
# FIRESTORE_PROJECT_ID=

FIRESTORE_META_POSTS_COLLECTION=meta_posts
FIRESTORE_POLL_INTERVAL_SECONDS=60
FIRESTORE_POLL_BATCH_SIZE=20

# A doc that reaches status "failed" is never re-published automatically: the user may
# have published the post manually after seeing the failure. Only an explicit re-queue
# from the app (status back to queued/scheduled) makes the bot publish it again.

# GCP auth for firestore.Client(): use a service account JSON on the server, e.g.
# export GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json
# (Not read by Config.py — standard Google client libraries.)
